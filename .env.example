# Leave empty to use the local SQLite file (file:./data/local.db).
# Set both to use Turso.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Extra Host headers the app accepts besides localhost / 127.0.0.1 / [::1]
# (comma separated, `name` for any port or `name:port`). Leave empty for local only.
ALLOWED_HOSTS=

# Folder for local data (SQLite file and PDFs), relative to the project or absolute.
# Leave empty for `data` (data/local.db, data/pdfs/). Prefer a folder under data/ or
# outside the repository: elsewhere inside the repo the PDFs are not gitignored.
# Use a path without spaces, `#` or `?`.
DATA_DIR=

# Shared file storage (Cloudflare R2 or any S3-compatible bucket) for photos and PDFs, so
# every PC using the same Turso DB sees the same files. Fill all four to turn it on; leave
# them empty to keep files in DATA_DIR. S3_REGION is optional (default `auto`, right for R2).
# R2: S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# Copy files saved before the switch with `npm run storage:push`.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Google sign-in (Auth.js). Fill all four to require sign-in; leave all empty to use the app
# on this machine without sign-in. Filling only some keeps the app closed with a setup page,
# and so does a deployment (Vercel, or a production server on another host) with none.
# AUTH_SECRET: a random string, e.g. `openssl rand -base64 32`.
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: Google Cloud OAuth client (see docs/DEPLOY.md).
# ALLOWED_EMAILS: comma-separated Google accounts that may sign in (case-insensitive),
# e.g. you@example.com
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAILS=

# Google Calendar, read-only (optional). Private iCal addresses, comma separated:
# Google Calendar → Settings → your calendar → Integrate calendar →
# "Secret address in iCal format". Treat them like passwords: only here (.env.local) or in
# the Vercel environment, never in the repository, logs or screenshots (see docs/DEPLOY.md 6).
GOOGLE_CALENDAR_ICS_URLS=
