{
  "name": "research-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "serve": "NEXT_DIST_DIR=.next-prod next build && NEXT_DIST_DIR=.next-prod next start -H 127.0.0.1 -p 3100",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "storage:push": "tsx scripts/storage-push.ts",
    "storage:gc-images": "tsx scripts/storage-gc-images.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@next/env": "^15.5.28",
    "@tiptap/extension-code-block-lowlight": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-table-cell": "^3.32.2",
    "@tiptap/extension-table-header": "^3.32.2",
    "@tiptap/extension-table-row": "^3.32.2",
    "@tiptap/extension-task-item": "^3.32.2",
    "@tiptap/extension-task-list": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "ical.js": "^2.2.1",
    "lowlight": "^3.3.0",
    "next": "^15.5.28",
    "next-auth": "5.0.0-beta.32",
    "pdfjs-dist": "6.3.289",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-force-graph-2d": "^1.29.2",
    "react-pdf": "^11.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "eslint-config-prettier": "^10.1.8",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "highlight.js": "~11.11.0"
  }
}
